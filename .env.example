# application.yml loads this file as Properties from the working directory; ENV_FILE can override the path.
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=image_hub
MYSQL_USERNAME=image_hub
MYSQL_PASSWORD=
# 可用 MYSQL_URL 覆盖完整 JDBC URL，例如配置数据库 TLS。

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_SSL_ENABLED=false

# 七牛云 Kodo，域名必须带协议并以 / 结尾，例如 https://cdn.example.com/。
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET_NAME=
QINIU_DOMAIN=
QINIU_BASE_PATH=ImgHub/

# 模型API Key的AES-256加密主密钥：32个随机字节的Base64；首次使用前设置并备份。
AI_MODEL_ENCRYPTION_KEY=
AI_WORKER_ENABLED=true

# 填写 SMTP 配置后开启；MAIL_PASSWORD 通常为邮箱 SMTP 授权码。
MAIL_VERIFICATION_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Image Hub
# 587 使用 STARTTLS；465 通常改为 STARTTLS=false、SSL=true。
MAIL_STARTTLS_ENABLED=true
MAIL_SSL_ENABLED=false
