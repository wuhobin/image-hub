# 复制为 app.env 并填写服务器配置；不要上传到 Git。
# 由 Compose env_file 的 raw 模式加载，值不加引号、不写 export、不在值后添加注释。
# 密码中的 $ 和反斜线直接填写；这里不是本地 Spring Properties 导入格式。
MYSQL_HOST=10.0.0.10
MYSQL_PORT=3306
MYSQL_DATABASE=image_hub
MYSQL_USERNAME=image_hub
MYSQL_PASSWORD=replace-with-mysql-password
# MYSQL_URL 可选；若使用则填写完整 JDBC URL，不要在其中嵌套 ${MYSQL_HOST} 等变量。

REDIS_HOST=10.0.0.11
REDIS_PORT=6379
REDIS_DATABASE=0
# 当前 YAML 注释掉了 Redis password；直接传 Spring 标准变量使认证生效。
SPRING_DATA_REDIS_PASSWORD=replace-with-redis-password
# Redis 没有密码时删除上一行；使用 ACL 用户时取消下一行注释并填写实际用户名。
# SPRING_DATA_REDIS_USERNAME=default
SPRING_DATA_REDIS_SSL_ENABLED=false

QINIU_ACCESS_KEY=replace-with-qiniu-access-key
QINIU_SECRET_KEY=replace-with-qiniu-secret-key
QINIU_BUCKET_NAME=replace-with-bucket-name
QINIU_DOMAIN=https://cdn.example.com/
QINIU_BASE_PATH=base/

# 当前应用使用 QQ SMTP：smtp.qq.com:465，SSL=true，STARTTLS=false。
# 填写真实邮箱及 SMTP 授权码后，再把开关改为 true。
MAIL_VERIFICATION_ENABLED=false
MAIL_USERNAME=you@qq.com
MAIL_PASSWORD=replace-with-smtp-authorization-code
MAIL_FROM_NAME=Image Hub
